* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: Arial;
  }

/* Layout Principal */
.layout {
display: flex;
min-height: 100vh;
}

/* Sidebar */
.sidebar {
width: 240px;
background: #003366;
color: white;
padding: 20px;
}

.sidebar .logo img {
width: 100%;
margin-bottom: 30px;
}

.sidebar a {
display: block;
margin: 10px 0;
color: white;
text-decoration: none;
font-weight: bold;
}

/* Header */
.header {
background: #f0f0f0;
padding: 20px;
border-bottom: 2px solid #ddd;
}

/* Content */
main {
flex: 1;
}

.content {
padding: 20px;
}
